# Set these as backend process environment variables. Spring does not load .env files automatically.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER/edgemart?retryWrites=true&w=majority
PORT=8081
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8081
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DELIVERY_RADIUS_KM=5
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
BREVO_API_KEY=
CONTACT_SENDER_EMAIL=vigneshpoloji@gmail.com
